{
  "name": "dsh-check-update",
  "version": "0.4.0",
  "description": "DSH 更新检查器（npm 版）：设置页检查 @deepseek-ai/dsh 是否有新版，导航红点提醒，一键更新、命令复制、更新说明预览与备份回滚。Check @deepseek-ai/dsh for updates, red-dot reminder, one-click update, command copying, release notes and rollback.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "updater",
    "npm"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2247069117/dsh-check-update.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
